# Cloudflare Pages HTTP Security & Caching Headers

# Global Security Baseline for All Routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://api.qrserver.com https://zin.zone; media-src 'self' blob: data: https://dict.youdao.com https://fanyi.baidu.com https://translate.google.com; connect-src 'self' https://dict.youdao.com https://fanyi.baidu.com https://translate.google.com https://api.qrserver.com; worker-src 'self'; child-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self';
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Service Worker - Zero Cache to Guarantee Instant OTA Updates
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# HTML Pages - Always Revalidate HTML for Instant Asset Version Refresh
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/pocket-cards.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Static Versioned Assets - 7-day Cache with Graceful Stale-While-Revalidate
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/data/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=2592000, immutable
/icon-192.png
  Cache-Control: public, max-age=2592000, immutable
/icon-512.png
  Cache-Control: public, max-age=2592000, immutable
/favicon.ico
  Cache-Control: public, max-age=2592000, immutable
