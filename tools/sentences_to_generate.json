[
  {
    "id": "d1_s1",
    "text": "打卡",
    "day": 1
  },
  {
    "id": "d1_s2",
    "text": "加班",
    "day": 1
  },
  {
    "id": "d1_s3",
    "text": "迟到了",
    "day": 1
  },
  {
    "id": "d1_s4",
    "text": "我想请假",
    "day": 1
  },
  {
    "id": "d1_s5",
    "text": "下班了",
    "day": 1
  },
  {
    "id": "d2_s1",
    "text": "快一点",
    "day": 2
  },
  {
    "id": "d2_s2",
    "text": "停一下",
    "day": 2
  },
  {
    "id": "d2_s3",
    "text": "搬过去",
    "day": 2
  },
  {
    "id": "d2_s4",
    "text": "再来一次",
    "day": 2
  },
  {
    "id": "d2_s5",
    "text": "听我说",
    "day": 2
  },
  {
    "id": "d3_s1",
    "text": "放这里",
    "day": 3
  },
  {
    "id": "d3_s2",
    "text": "拿给我",
    "day": 3
  },
  {
    "id": "d3_s3",
    "text": "放在那里",
    "day": 3
  },
  {
    "id": "d3_s4",
    "text": "拿走吧",
    "day": 3
  },
  {
    "id": "d3_s5",
    "text": "在哪里",
    "day": 3
  },
  {
    "id": "d4_s1",
    "text": "不合格",
    "day": 4
  },
  {
    "id": "d4_s2",
    "text": "坏了",
    "day": 4
  },
  {
    "id": "d4_s3",
    "text": "重做",
    "day": 4
  },
  {
    "id": "d4_s4",
    "text": "检查一下",
    "day": 4
  },
  {
    "id": "d4_s5",
    "text": "合格了",
    "day": 4
  },
  {
    "id": "d5_s1",
    "text": "机器坏了",
    "day": 5
  },
  {
    "id": "d5_s2",
    "text": "没有料了",
    "day": 5
  },
  {
    "id": "d5_s3",
    "text": "去领料",
    "day": 5
  },
  {
    "id": "d5_s4",
    "text": "工具在哪",
    "day": 5
  },
  {
    "id": "d5_s5",
    "text": "叫维修工",
    "day": 5
  },
  {
    "id": "d6_s1",
    "text": "小心危险",
    "day": 6
  },
  {
    "id": "d6_s2",
    "text": "我去上厕所",
    "day": 6
  },
  {
    "id": "d6_s3",
    "text": "喝水",
    "day": 6
  },
  {
    "id": "d6_s4",
    "text": "吃饭了",
    "day": 6
  },
  {
    "id": "d6_s5",
    "text": "累死了",
    "day": 6
  },
  {
    "id": "d7_s1",
    "text": "老板，打卡机坏了",
    "day": 7
  },
  {
    "id": "d7_s2",
    "text": "料不够，我去仓库领",
    "day": 7
  },
  {
    "id": "d7_s3",
    "text": "这个不合格，我重做",
    "day": 7
  },
  {
    "id": "d7_s4",
    "text": "机器卡住了，叫维修",
    "day": 7
  },
  {
    "id": "d7_s5",
    "text": "太累了，想喝口水",
    "day": 7
  },
  {
    "id": "d8_s1",
    "text": "我叫阿雄",
    "day": 8
  },
  {
    "id": "d8_s2",
    "text": "我做这个三年了",
    "day": 8
  },
  {
    "id": "d8_s3",
    "text": "我学得很快",
    "day": 8
  },
  {
    "id": "d8_s4",
    "text": "我很听话",
    "day": 8
  },
  {
    "id": "d8_s5",
    "text": "请多关照",
    "day": 8
  },
  {
    "id": "d9_s1",
    "text": "我不会做",
    "day": 9
  },
  {
    "id": "d9_s2",
    "text": "请教我",
    "day": 9
  },
  {
    "id": "d9_s3",
    "text": "请再说一遍",
    "day": 9
  },
  {
    "id": "d9_s4",
    "text": "是这个吗",
    "day": 9
  },
  {
    "id": "d9_s5",
    "text": "我听懂了",
    "day": 9
  },
  {
    "id": "d10_s1",
    "text": "做完了",
    "day": 10
  },
  {
    "id": "d10_s2",
    "text": "还没做完",
    "day": 10
  },
  {
    "id": "d10_s3",
    "text": "有点问题",
    "day": 10
  },
  {
    "id": "d10_s4",
    "text": "还要半小时",
    "day": 10
  },
  {
    "id": "d10_s5",
    "text": "今天超产了",
    "day": 10
  },
  {
    "id": "d11_s1",
    "text": "我身体不舒服",
    "day": 11
  },
  {
    "id": "d11_s2",
    "text": "家里有急事",
    "day": 11
  },
  {
    "id": "d11_s3",
    "text": "我想换班",
    "day": 11
  },
  {
    "id": "d11_s4",
    "text": "绝不耽误事",
    "day": 11
  },
  {
    "id": "d11_s5",
    "text": "下周我补上",
    "day": 11
  },
  {
    "id": "d12_s1",
    "text": "多少个",
    "day": 12
  },
  {
    "id": "d12_s2",
    "text": "一百个",
    "day": 12
  },
  {
    "id": "d12_s3",
    "text": "差五个",
    "day": 12
  },
  {
    "id": "d12_s4",
    "text": "这一箱",
    "day": 12
  },
  {
    "id": "d12_s5",
    "text": "数量不够",
    "day": 12
  },
  {
    "id": "d13_s1",
    "text": "今天必须要",
    "day": 13
  },
  {
    "id": "d13_s2",
    "text": "明天早上交",
    "day": 13
  },
  {
    "id": "d13_s3",
    "text": "几点交货",
    "day": 13
  },
  {
    "id": "d13_s4",
    "text": "周末加不加班",
    "day": 13
  },
  {
    "id": "d13_s5",
    "text": "什么时候发工资",
    "day": 13
  },
  {
    "id": "d14_s1",
    "text": "主管，今天这一单做完了",
    "day": 14
  },
  {
    "id": "d14_s2",
    "text": "差五十个，半小时搞定",
    "day": 14
  },
  {
    "id": "d14_s3",
    "text": "这个零件有问题，请教我",
    "day": 14
  },
  {
    "id": "d14_s4",
    "text": "周末我想加班，我很能干",
    "day": 14
  },
  {
    "id": "d14_s5",
    "text": "放心老板，质量没问题",
    "day": 14
  },
  {
    "id": "d15_s1",
    "text": "主管太厉害了",
    "day": 15
  },
  {
    "id": "d15_s2",
    "text": "跟着你学到很多",
    "day": 15
  },
  {
    "id": "d15_s3",
    "text": "老大辛苦了",
    "day": 15
  },
  {
    "id": "d15_s4",
    "text": "老板眼光真好",
    "day": 15
  },
  {
    "id": "d15_s5",
    "text": "跟你干真有前途",
    "day": 15
  },
  {
    "id": "d16_s1",
    "text": "我想多学点",
    "day": 16
  },
  {
    "id": "d16_s2",
    "text": "让我试试看",
    "day": 16
  },
  {
    "id": "d16_s3",
    "text": "我不怕累",
    "day": 16
  },
  {
    "id": "d16_s4",
    "text": "我想负责这条线",
    "day": 16
  },
  {
    "id": "d16_s5",
    "text": "我随时随地能顶上",
    "day": 16
  },
  {
    "id": "d17_s1",
    "text": "我敬主管一杯",
    "day": 17
  },
  {
    "id": "d17_s2",
    "text": "您随意，我干了",
    "day": 17
  },
  {
    "id": "d17_s3",
    "text": "吃好喝好",
    "day": 17
  },
  {
    "id": "d17_s4",
    "text": "祝老板生意发大财",
    "day": 17
  },
  {
    "id": "d17_s5",
    "text": "我喝倒了也陪您",
    "day": 17
  },
  {
    "id": "d18_s1",
    "text": "加班费怎么算",
    "day": 18
  },
  {
    "id": "d18_s2",
    "text": "这个月有奖金吗",
    "day": 18
  },
  {
    "id": "d18_s3",
    "text": "表现好能涨工资吗",
    "day": 18
  },
  {
    "id": "d18_s4",
    "text": "老板不会亏待我",
    "day": 18
  },
  {
    "id": "d18_s5",
    "text": "最近物价太贵了",
    "day": 18
  },
  {
    "id": "d19_s1",
    "text": "老大，我想当组长",
    "day": 19
  },
  {
    "id": "d19_s2",
    "text": "大家都服我",
    "day": 19
  },
  {
    "id": "d19_s3",
    "text": "我能管好这条线",
    "day": 19
  },
  {
    "id": "d19_s4",
    "text": "保证不出错",
    "day": 19
  },
  {
    "id": "d19_s5",
    "text": "给我个机会证明",
    "day": 19
  },
  {
    "id": "d20_s1",
    "text": "对不起，是我的疏忽",
    "day": 20
  },
  {
    "id": "d20_s2",
    "text": "下次我一定注意",
    "day": 20
  },
  {
    "id": "d20_s3",
    "text": "不是我不做，是没物料",
    "day": 20
  },
  {
    "id": "d20_s4",
    "text": "别生气，消消气",
    "day": 20
  },
  {
    "id": "d20_s5",
    "text": "我马上改过来",
    "day": 20
  },
  {
    "id": "d21_s1",
    "text": "老板，占用您两分钟",
    "day": 21
  },
  {
    "id": "d21_s2",
    "text": "来公司两年，我成长很多",
    "day": 21
  },
  {
    "id": "d21_s3",
    "text": "我能帮您分担更多",
    "day": 21
  },
  {
    "id": "d21_s4",
    "text": "让我当组长，产量提两成",
    "day": 21
  },
  {
    "id": "d21_s5",
    "text": "感谢老板栽培，我跟定您了",
    "day": 21
  },
  {
    "id": "boss_1",
    "text": "快点搞！",
    "type": "boss"
  },
  {
    "id": "boss_2",
    "text": "搞什么鬼？",
    "type": "boss"
  },
  {
    "id": "boss_3",
    "text": "行不行啊？",
    "type": "boss"
  },
  {
    "id": "boss_4",
    "text": "听懂了没有？",
    "type": "boss"
  },
  {
    "id": "boss_5",
    "text": "差不多就行了",
    "type": "boss"
  },
  {
    "id": "boss_6",
    "text": "辛苦了！",
    "type": "boss"
  }
]