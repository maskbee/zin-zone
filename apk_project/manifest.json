{
    "@platforms": [
        "android"
    ],
    "id": "__UNI__ZINZONE",
    "name": "Zin Zone",
    "version": {
        "name": "1.0.0",
        "code": "100"
    },
    "description": "Zin Zone - Trò Chơi Tu Luyện Tiếng Trung",
    "icons": {
        "72": "unpackage/res/icons/72x72.png"
    },
    "launch_path": "https://zin.zone",
    "developer": {
        "name": "Zin Zone",
        "email": "admin@zin.zone",
        "url": "https://zin.zone"
    },
    "permissions": {
        "Webview": {
            "description": "网页视图容器"
        },
        "Events": {
            "description": "应用扩展事件"
        },
        "Storage": {
            "description": "本地缓存存储"
        },
        "Cache": {
            "description": "管理应用缓存"
        },
        "Audio": {
            "description": "音频播放及音效引擎"
        },
        "Navigator": {
            "description": "浏览器内核及状态栏控制"
        },
        "NativeUI": {
            "description": "原生交互提示"
        },
        "Runtime": {
            "description": "运行时环境"
        }
    },
    "plus": {
        "kernel": {
            "ios": "WKWebview"
        },
        "launchwebview": {
            "contentAdjust": false,
            "render": "always",
            "background": "#090d16"
        },
        "splashscreen": {
            "autoclose": true,
            "waiting": false,
            "delay": 0
        },
        "statusbar": {
            "immersed": "supportedDevice",
            "style": "light"
        },
        "popGesture": "close",
        "runmode": "liberate",
        "signature": "Sk9JTiBVUyBDT01QQU5Z",
        "distribute": {
            "google": {
                "packagename": "zone.zin.app",
                "keystore": "",
                "password": "",
                "aliasname": "",
                "permissions": [
                    "<uses-permission android:name=\"android.permission.INTERNET\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.MODIFY_AUDIO_SETTINGS\"/>"
                ]
            },
            "orientation": [
                "portrait-primary"
            ],
            "icons": {
                "android": {
                    "mdpi": "unpackage/res/icons/48x48.png",
                    "hdpi": "unpackage/res/icons/72x72.png",
                    "xhdpi": "unpackage/res/icons/96x96.png",
                    "xxhdpi": "unpackage/res/icons/144x144.png",
                    "xxxhdpi": "unpackage/res/icons/192x192.png"
                }
            },
            "splashscreen": {
                "android": {
                    "mdpi": "",
                    "ldpi": "",
                    "hdpi": "",
                    "xhdpi": "",
                    "xxhdpi": ""
                }
            }
        }
    }
}
